{
  "name": "flareward-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "焰卫 — Telegram 群管理机器人，Cloudflare Worker 与本机长轮询共用一套核心",
  "scripts": {
    "dev": "node --experimental-strip-types src/node.ts",
    "worker:dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage test/*.test.ts",
    "live": "node --experimental-strip-types scripts/live-check.ts",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "he": "^2.0.0",
    "lru-cache": "^11.5.3",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.154.0"
  }
}
